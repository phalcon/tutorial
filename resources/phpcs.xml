<?xml version="1.0"?>
<ruleset name="Tutorial">
    <description>Phalcon Tutorial Coding Standards</description>

    <!-- Arguments:
         p = Show progress
         s = Show sniff codes in output
         colors = Force color output (optional, often auto-detected)
    -->
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="Phalcon"/>
    <file>../src</file>
    <file>../public/index.php</file>
    <file>../tests</file>

    <!-- Tooling caches (PHPStan tmpDir, PHPUnit/CS-Fixer caches) live here -->
    <exclude-pattern>*/tests/_output/*</exclude-pattern>
</ruleset>
